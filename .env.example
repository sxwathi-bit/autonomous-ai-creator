# Autonomous AI Creator Environment Configuration

# Server & Network Configuration
PORT=3000
NODE_ENV=development
DEV_MODE=true
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Database Configuration (PostgreSQL for production, SQLite supported locally)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autonomous_creator?schema=public"

# AI Provider Credentials
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Live Search & Discovery Credentials
TAVILY_API_KEY=""

# Autonomous Worker Scheduling Settings
# In production (DEV_MODE=false), values are in minutes (e.g., 180 to 420 = 3h to 7h)
MIN_PUBLISH_INTERVAL_MINUTES=180
MAX_PUBLISH_INTERVAL_MINUTES=420

# Development Mode Fast Interval Settings (in seconds)
DEV_MIN_INTERVAL_SECONDS=30
DEV_MAX_INTERVAL_SECONDS=90

# Editorial Scoring Threshold (0 - 100)
EDITORIAL_THRESHOLD=65
